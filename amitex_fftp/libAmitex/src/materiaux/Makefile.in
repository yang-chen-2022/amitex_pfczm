lAmitex=$(AMITEX_PATH)/libAmitex

# options :
# NO_US pour supprime les ajout de sous-tirets (incompatible avec l'appel via umat_read)
# FASTMATH (pour gnu) accelere certaines fonctions... mais ATTENTION, comportement incertain.
# DEF_INT : pour assurer la compatibilite avec l'interface umat d'mfront et de cast3m,
#           les entiers par defaut sont codes sur 8 bits
#=============================================================
#
# Use amitex_fftp-config tool :
# -----------------------------
# To access help, once AMITEX installed :
#    - source (amitex)/env_amitex.sh
#    - amitex_fftp-config --help
#
#=============================================================

FASTMATHgnu=TO_BE_FILLED

AMITEX_CFG=$(lAmitex)/bin/amitex_fftp-config

F90 := $(shell "$(AMITEX_CFG)" --fc)
F90FLAGS := $(shell "$(AMITEX_CFG)" --fcflags --fcflags-opt)

G_TEST := $(shell "$(F90)" --version | grep -ic "gnu")
I_TEST := $(shell "$(F90)" --version | grep -ic "intel")
P_TEST := $(shell "$(F90)" --version | grep -ic "pgi")
N_TEST := $(shell "$(F90)" --version | grep -ic "NVIDIA")

ifneq ($(G_TEST), 0)
 	NO_US=-fno-underscoring
	FASTMATH=$(FASTMATHgnu)
	DEF_INT=-fdefault-integer-8
endif

ifneq ($(I_TEST), 0)
	NO_US=-assume nounderscore
	FASTMATH=
	DEF_INT=-i8
endif

ifneq ($(P_TEST), 0)
	DEF_INT=-i8
endif

ifneq ($(N_TEST), 0)
	DEF_INT=-i8
endif


# fichiers sources et objets correspondants
SRC = $(wildcard *.f90) $(wildcard *.F)
OBJ=$(SRC:.f90=.o) $(SRC:.F=.o)

#-------------------------------------------------------------
#                                             OPTIONS DE DEBUG
#debug intel
#DEBUG=-g -check all -fpe0 -warn -traceback -debug extended
#DEBUG=-g -check all
#DEBUG=-warn all, -warn nounused
#for polyxCC : simply use -fpe0 to avoid pb when using amitex with DEBUG

#debug gcc
#DEBUG=-Wall -Wno-unused-dummy-argument
#DEBUG=-g -fcheck=all
#
DEBUG=
#-------------------------------------------------------------

#compilation de la librairie libUmatAmitex.so
all : $(OBJ)
	$(F90) -o libUmatAmitex.so -shared *.o

#regle generique
# Compilation des sources (fortran)
%.o : %.f90
	$(F90) $(F90FLAGS) $(DEF_INT) $(NO_US) $(FASTMATH) $(DEBUG) -fPIC -DPIC -c $<
	rm -f *__genmod.* # files generated by ifort -warn

# Compilation des sources (fortran)
%.o : %.F
	$(F90) $(F90FLAGS) $(DEF_INT) $(NO_US) $(FASTMATH) $(DEBUG) -fPIC -DPIC -c $<
	rm -f *__genmod.* # files generated by ifort -warn

clean:
	rm -f *.o
	rm -f *.so

